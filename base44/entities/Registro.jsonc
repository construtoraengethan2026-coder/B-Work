{
  "name": "Registro",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "title": "Obra"
    },
    "ambiente_id": {
      "type": "string",
      "title": "Ambiente"
    },
    "tipo": {
      "type": "string",
      "title": "Tipo",
      "enum": [
        "ocorrencia",
        "vistoria",
        "servico",
        "observacao",
        "entrega",
        "outro"
      ],
      "default": "observacao"
    },
    "titulo": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    }
  },
  "required": [
    "obra_id",
    "titulo"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}